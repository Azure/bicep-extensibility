<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Azure.Deployments.Extensibility.TypeGeneration</RootNamespace>
    <EnableNuget>true</EnableNuget>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Build-time authoring and type generation for Bicep extensions.</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Bicep.Types" Version="0.6.144" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Azure.Deployments.Extensibility.TypeGeneration.Tests" />
  </ItemGroup>

</Project>
